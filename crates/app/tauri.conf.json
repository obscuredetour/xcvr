{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transceiver",
  "mainBinaryName": "xcvr",
  "identifier": "com.obscuredetour.xcvr",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Transceiver",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 440,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["magnet"] }
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent Document",
        "description": "BitTorrent Document",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": { "desktopTemplate": "linux/xcvr.desktop" },
      "rpm": { "desktopTemplate": "linux/xcvr.desktop" }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
