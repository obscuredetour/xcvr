{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transceiver",
  "mainBinaryName": "xcvr",
  "identifier": "com.obscuredetour.xcvr",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Transceiver",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 440,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxNkFCQjMxRjNGNDZCOUIKUldTYmEvVHpNYnRxMFhsY2phZWhoV00xY3ZyTmliL3QvVGlkcFVVSnd1MnQ3RHBSL2pCbXUrbm8K",
      "endpoints": [
        "https://github.com/obscuredetour/xcvr/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "A desktop client for Transmission",
    "longDescription": "Transceiver connects to a Transmission running on another computer (a NAS, a home server or a seedbox) and gives it a native desktop app: a live table of torrents, an inspector, labels and folders, and a menu bar or tray icon.",
    "homepage": "https://github.com/obscuredetour/xcvr",
    "publisher": "obscuredetour",
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent Document",
        "description": "BitTorrent Document",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/xcvr.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/xcvr.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}